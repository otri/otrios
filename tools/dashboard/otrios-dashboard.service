[Unit]
Description=OTriOS native GLES2 dashboard with signed live updates
Requires=spd-weston.service
After=spd-weston.service tailscaled.service
Wants=tailscaled.service
Conflicts=spd-browser.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=kiosk
Group=kiosk
SupplementaryGroups=video render
EnvironmentFile=/etc/otrios-dashboard.conf
Environment=HOME=/home/kiosk
Environment=XDG_CACHE_HOME=/var/lib/otrios-dashboard
Environment=XDG_RUNTIME_DIR=/run/spd-kiosk
Environment=WAYLAND_DISPLAY=wayland-0
Environment=LD_LIBRARY_PATH=/opt/otrios-dashboard/lib
StateDirectory=otrios-dashboard
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/python3 -u /opt/otrios-dashboard/frame-dashboard-agent.py --url ${DASHBOARD_URL} --cache /var/lib/otrios-dashboard --runtime-dir /run/spd-kiosk/otrios --cache-bytes 2147483648 --key /opt/otrios-dashboard/publisher.pem --capture-first-frame
# A successful restart must not queue the conflicting browser start job.
ExecStopPost=+/bin/sh -c 'test "$$SERVICE_RESULT" = success || exec /usr/bin/systemctl --no-block start spd-browser.service'
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
KillMode=mixed
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
