# Direct native host; enable this service for boot after deployment acceptance.
[Unit]
Description=OTriOS direct KMS/GBM GLES2 dashboard
After=otrios-dashboard.service spd-weston.service spd-browser.service tailscaled.service
Conflicts=otrios-dashboard.service spd-weston.service spd-browser.service
Wants=tailscaled.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=kiosk
Group=kiosk
SupplementaryGroups=video render input
Environment=DASHBOARD_CODE_URL=https://otrios.otri.ca
EnvironmentFile=/etc/otrios-dashboard.conf
Environment=HOME=/home/kiosk
Environment=OTRIOS_SCANOUT_FORMAT=rgb565
Environment=DASHBOARD_TOUCH_RULE=/etc/udev/rules.d/99-spd-touch.rules
Environment=XDG_CACHE_HOME=/var/lib/otrios-dashboard
Environment=LD_LIBRARY_PATH=/opt/otrios-dashboard/lib
StateDirectory=otrios-dashboard
StateDirectoryMode=0700
RuntimeDirectory=otrios-direct-console
RuntimeDirectoryMode=0700
UMask=0077
ExecStartPre=+/usr/bin/python3 /opt/otrios-dashboard/frame-console-mode.py enter
# The accepted rule path is configured during installation, without changing its bytes.
ExecStart=/usr/bin/python3 -u /opt/otrios-dashboard/frame-dashboard-agent.py --url ${DASHBOARD_URL} --code-url ${DASHBOARD_CODE_URL} --cache /var/lib/otrios-dashboard --runtime-dir /run/otrios-direct-console/otrios --cache-bytes 2147483648 --key /opt/otrios-dashboard/publisher.pem --video-driver KMSDRM --rotation 90 --touch-calibration ${DASHBOARD_TOUCH_RULE} --capture-first-frame
ExecStopPost=+/usr/bin/python3 /opt/otrios-dashboard/frame-console-mode.py restore
# Native update failures roll back to a verified direct release in the agent.
Restart=no
TimeoutStopSec=15
KillMode=mixed
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# Input/display discovery uses the udev netlink monitor.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
