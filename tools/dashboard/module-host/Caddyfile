{
    admin off
    auto_https off
}
:8080 {
    route {
        # Public code and demo sync. Monitoring authorization is enforced by
        # the separate server adapter before any private snapshot is delivered.
        header {
            X-Content-Type-Options nosniff
            Referrer-Policy same-origin
            Cache-Control no-store
        }
        handle / {
            root * /srv/bootstrap
            rewrite * /index.html
            file_server
        }
        handle /release {
            root * /srv/modules
            rewrite * /current.json
            file_server
        }
        handle /releases/* {
            root * /srv/modules
            header Cache-Control "public, max-age=31536000, immutable"
            file_server
        }
        @state path /stream /demo/stream /auth/session /monitoring/presentation /monitoring/stream /health
        handle @state {
            reverse_proxy {$OTRIOS_PUBLIC_UPSTREAM:host.docker.internal:8878} {
                # Ignore cached Basic credentials; Monitoring uses a host-only
                # HttpOnly session cookie, checked by the server adapter.
                header_up -Authorization
            }
        }
        handle {
            respond "Not found" 404
        }
    }
}
